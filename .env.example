# SENTINEL AI — Environment Configuration
# Copy to .env and replace placeholder values.
# NEVER commit .env to version control.

# === Application ===
APP_ENV=development
APP_NAME=SENTINEL_AI
API_V1_PREFIX=/api/v1
APP_SECRET_KEY=replace_with_local_random_secret
JWT_SECRET_KEY=replace_with_local_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173

# === Database ===
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_password@localhost:5432/sentinel

# === SIEM Provider ===
SIEM_PROVIDER=synthetic
SENTINEL_DATA_MODE=synthetic
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_ALLOWLIST=logs-*,wazuh-alerts-*

# === Wazuh ===
WAZUH_API_URL=https://wazuh-manager
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
WAZUH_API_VERSION=

# === LLM ===
LLM_PROVIDER=cloud
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# === Query Safety ===
MAX_QUERY_WINDOW_HOURS=168
MAX_QUERY_PAGE_SIZE=500
MAX_AGGREGATION_BUCKETS=100
QUERY_TIMEOUT_SECONDS=30

# === Reports ===
REPORT_STORAGE_PATH=./artifacts
APP_LOG_LEVEL=INFO
